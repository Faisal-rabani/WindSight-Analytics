# UK Wind Power Forecast Intelligence Platform - Environment Configuration

# Flask Backend
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-demo-key-12345
DATABASE_URL=sqlite:///data/wind_forecast.db
PORT=5000

# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Analysis Assumptions
DECISION_CUTOFF_TIME=10:00
DEFAULT_TIMEZONE=Europe/London
ANALYSIS_PERIOD_START=2026-01-01
ANALYSIS_PERIOD_END=2026-01-31

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
